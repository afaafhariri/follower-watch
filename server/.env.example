PORT=8080

# Comma-separated; if unset, any origin is allowed
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Session signing key, required: the server won't start without it.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=your-random-secret-key-here

# Frontend URL for OAuth redirect
FRONTEND_URL=http://localhost:3000

# Redis, optional: leave unset to disable "show my last result" caching.
# Local: redis://localhost:6379, Docker: redis://redis:6379,
# hosted (e.g. Upstash): rediss://default:PASSWORD@HOST:6379
REDIS_URL=redis://localhost:6379

# Built frontend to serve, optional (default: ../web/dist; the Docker image sets it)
# STATIC_DIR=../web/dist
