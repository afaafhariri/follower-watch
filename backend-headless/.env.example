# ── Google Drive access (pick ONE option) ────────────────────────────────
# Option A (recommended): your own OAuth client + refresh token.
# 1. Create a Google Cloud project, enable the Drive API.
# 2. Configure the OAuth consent screen (External) and PUBLISH it to
#    production — apps left in "Testing" get refresh tokens that expire
#    after 7 days.
# 3. Create an OAuth client (type: Web application) with redirect URI
#    http://localhost:8090/callback
# 4. Fill the two values below, then run:  go run . -authorize
# 5. Paste the printed refresh token here.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=paste-output-of-authorize-here

# Option B: a service account key file. Only works if the daily meta-*
# export folders land inside a Drive folder you shared with the service
# account's email address.
#GOOGLE_SERVICE_ACCOUNT_FILE=/app/service-account.json

# ── Email (SMTP with STARTTLS; e.g. Gmail + app password) ────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Both default to SMTP_USER; EMAIL_TO takes a comma-separated list.
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# ── Schedule ─────────────────────────────────────────────────────────────
# Cron format (minute hour day month weekday). Default: 1:30 AM nightly.
CRON_SCHEDULE=30 1 * * *
# Timezone the schedule runs in, e.g. Asia/Colombo, Europe/Berlin.
TZ=UTC

# Where the follower snapshot (state.json) is stored between runs.
DATA_DIR=./data
